<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />

    <!-- El middleware que lee la cabecera Authorization: Bearer, valida el token y arma
         el ClaimsPrincipal de la petición. Va SOLO aquí: ninguna otra capa sabe que la
         autenticación viaja por HTTP. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.*" />

    <!-- Serilog vive ÚNICAMENTE en este proyecto. Las capas Servicios y Aplicación
         registran contra ILogger<T> de Microsoft.Extensions.Logging.Abstractions, que es
         solo la interfaz: cambiar Serilog por NLog sería editar este archivo y la clase
         ConfiguracionRegistro, sin tocar un solo servicio. Eso es inversión de
         dependencias aplicada al logging. -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.*" />

    <!-- Solo para que las herramientas `dotnet ef` puedan construir el DbContext en tiempo
         de diseño: este es el proyecto de arranque y ahí es donde el tooling busca el
         paquete. Con PrivateAssets=all no se propaga a nadie ni se publica en la salida:
         es una dependencia de compilación, no de ejecución. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SB.GestionPagos.Servicios\SB.GestionPagos.Servicios.csproj" />
    <ProjectReference Include="..\SB.GestionPagos.Infraestructura\SB.GestionPagos.Infraestructura.csproj" />
  </ItemGroup>

</Project>
